<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="backgroundColor">#fffbeb</color>
    <color name="colorPrimary">#f59e0b</color>
    <color name="colorPrimaryDark">#d97706</color>
    <color name="navigationColor">#000000</color>
    <string name="app_name">nyanQuest</string>
    <string name="asset_statements">
        [{
            \"relation\": [\"delegate_permission/common.handle_all_urls\"],
            \"target\": {
                \"namespace\": \"web\",
                \"site\": \"https://nyanquest.vercel.app\"
            }
        }]
    </string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>